              <calculation class='tableau' formula='AVG(IF [Profit Margin (copy) (copy)_1305188662620178] = &quot;Delayed&quot; THEN [Processing Days] - [Profit Margin (copy)_1305188662611985] &#13;&#10;END)' />
            </column>
