            <column caption='Processing Compliance %' datatype='real' default-format='p0.00%' name='[Profit Margin (copy) (copy) (copy) (copy) (copy)_1305188662702101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Profit Margin (copy) (copy) (copy)_1305188662628371] / [Total Profit (copy) (copy)_1305188649684995]' />
            </column>
            <column caption='Processing On Time Orders' datatype='integer' name='[Profit Margin (copy) (copy) (copy)_1305188662628371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Profit Margin (copy) (copy)_1305188662620178] = &quot;On Time&quot; THEN [Order ID] END)' />
            </column>
            <column caption='Processing Status' datatype='string' name='[Profit Margin (copy) (copy)_1305188662620178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Processing Days] &lt;= [Profit Margin (copy)_1305188662611985] THEN &quot;On Time&quot; &#13;&#10;ELSE &quot;Delayed&quot; END' />
            </column>
            <column caption='Processing SLA Target Days' datatype='integer' name='[Profit Margin (copy)_1305188662611985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Ship Mode] = &quot;Same Day&quot; THEN 0 &#13;&#10;ELSEIF [Ship Mode] = &quot;First Class&quot; THEN 1 &#13;&#10;ELSEIF [Ship Mode] = &quot;Second Class&quot; THEN 2 &#13;&#10;ELSE 3 &#13;&#10;END' />
