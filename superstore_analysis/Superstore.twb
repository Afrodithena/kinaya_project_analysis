    <worksheet name='Table_Processing Status'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+ (superstore(AutoRecovered))' name='federated.0gpxwa80o7zt4f1f2f0s207qbnri' />
          </datasources>
          <datasource-dependencies datasource='federated.0gpxwa80o7zt4f1f2f0s207qbnri'>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Processing Days]' role='measure' type='quantitative' />
            <column caption='Processing Status' datatype='string' name='[Profit Margin (copy) (copy)_1305188662620178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Processing Days] &lt;= [Profit Margin (copy)_1305188662611985] THEN &quot;On Time&quot; &#13;&#10;ELSE &quot;Delayed&quot; END' />
