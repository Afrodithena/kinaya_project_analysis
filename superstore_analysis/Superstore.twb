    <worksheet name='calculation'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_sales+ (superstore(AutoRecovered))' name='federated.0gpxwa80o7zt4f1f2f0s207qbnri' />
          </datasources>
          <datasource-dependencies datasource='federated.0gpxwa80o7zt4f1f2f0s207qbnri'>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Discount Range]' role='dimension' type='nominal' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Discount]' role='measure' type='quantitative' />
            <column caption='AOV' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Loss % (copy) (copy) (copy)_1305188669308957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
            </column>
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Processing Days]' role='measure' type='quantitative' />
            <column caption='Revenue at Risk' datatype='real' datatype-customized='true' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Profit Margin (copy) (copy) (copy)_1305188653019149]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM(IF [Profit Margin (copy) (copy)_1305188662620178] = &quot;Delayed&quot; THEN [Sales] &#13;&#10;END)' />
            </column>
            <column caption='Discount ROI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Profit Margin (copy) (copy)_1305188652965900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales] * [Discount])' />
            </column>
            <column caption='Processing Status' datatype='string' name='[Profit Margin (copy) (copy)_1305188662620178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Processing Days] &lt;= [Profit Margin (copy)_1305188662611985] THEN &quot;On Time&quot; &#13;&#10;ELSE &quot;Delayed&quot; END' />
            </column>
            <column caption='Weighted Discount %' datatype='real' default-format='p0.00%' name='[Profit Margin (copy)_1305188652953611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales] * [Discount]) / SUM([Sales])' />
            </column>
            <column caption='Processing SLA Target Days' datatype='integer' name='[Profit Margin (copy)_1305188662611985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Ship Mode] = &quot;Same Day&quot; THEN 0 &#13;&#10;ELSEIF [Ship Mode] = &quot;First Class&quot; THEN 1 &#13;&#10;ELSEIF [Ship Mode] = &quot;Second Class&quot; THEN 2 &#13;&#10;ELSE 3 &#13;&#10;END' />
            </column>
            <column datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
            <column caption='Total Discount Value' datatype='real' datatype-customized='true' default-format='C1033%' name='[Total Customers (copy) (copy) (copy) (copy) (copy)_1305188650201098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales] * [Discount])' />
            </column>
            <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Total Customers (copy)_1305188650131462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
            </column>
            <column caption='Total Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Total Profit (copy) (copy)_1305188649684995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='Sales Before Discount ' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Total Sales (copy)_0913969459220510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sales] / (1 - [Discount])' />
            </column>
            <column caption='Delay Rate' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Total Sales (copy)_0913969517420575]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Profit Margin (copy) (copy)_1305188662620178] = &quot;Delayed&quot; THEN [Order ID] END) / COUNTD([Order ID])' />
            </column>
