            <column datatype='string' name='[Product ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column caption='Sales at No Discount' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Profit Margin (copy) (copy) (copy) (copy) (copy) (copy)_1305188662706198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales] / (1 - [Discount]))' />
